<?xml version="1.0" encoding="utf-8"?>
<!-- Release and normal builds: HTTPS only. Debug builds override this file under
     src/debug/res/xml/ to permit the emulator and LAN development servers. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
