<?xml version="1.0" encoding="utf-8"?>
<!-- Debug only: allows a locally hosted Easy Gateway backend over HTTP
     (10.0.2.2 on the Android emulator or a private LAN address on a phone).
     The release build uses src/main/res/xml/network_security_config.xml, which
     blocks cleartext traffic. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
