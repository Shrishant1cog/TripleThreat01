{
  "name": "easy-gateway-android",
  "version": "1.0.1",
  "private": true,
  "description": "Easy Gateway retail management Android app (Capacitor shell around the existing Easy Gateway web frontend and API).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/core.test.mjs tests/config.test.mjs tests/app-invariants.test.mjs",
    "verify:web": "node scripts/verify-web.mjs",
    "android:sync": "npx cap sync android",
    "android:add": "npx cap add android",
    "android:build": "node scripts/build-android.mjs",
    "android:build:prod": "node scripts/build-android.mjs --env production",
    "android:build:emulator": "node scripts/build-android.mjs --env emulator",
    "android:build:lan": "node scripts/build-android.mjs --env lan --lan-ip auto",
    "android:build:release": "node scripts/build-android.mjs --env production --release",
    "android:open": "npx cap open android",
    "android:install": "adb install -r dist/EasyGateway-production-debug.apk",
    "android:install:emulator": "adb install -r dist/EasyGateway-emulator-debug.apk"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/barcode-scanner": "3.1.3",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "typescript": "5.9.3"
  }
}
