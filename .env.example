# Local development only. Use a long random secret; never commit a real .env file.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/easy_gateway
SESSION_SECRET=replace-with-a-long-random-secret
# Set to true only if your database requires TLS.
DATABASE_SSL=false
# Phone-reachable origin for QR links, e.g. http://192.168.1.20:3000.
# Loopback addresses are rejected by the QR endpoints.
PUBLIC_APP_URL=
# Optional email delivery. SMTP_URL is tried first; Resend is the fallback.
# Leave both unset to keep order emails queued/not_sent instead of claiming delivery.
SMTP_URL=
EMAIL_FROM=Easy Gateway <orders@example.com>
RESEND_API_KEY=
