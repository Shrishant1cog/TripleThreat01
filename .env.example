# Local development only. Replace placeholders with local values; never commit a real .env file.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/easy_gateway
SESSION_SECRET=replace-with-a-long-random-secret
PUBLIC_APP_URL=http://192.168.1.20:3000
# Set to true only if your database requires TLS.
DATABASE_SSL=false
